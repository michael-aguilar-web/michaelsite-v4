---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/external-links.css';
interface Props { title?: string; description?: string; section?: string; pageClass?: string; backHref?: string; backLabel?: string; }
const { title = 'Michael Aguilar', description = 'Michael Aguilar’s projects and FRC notes.', section = '', pageClass = '', backHref, backLabel } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {section === 'wiki' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/bean.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300..700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {section !== 'home' && <SiteHeader backHref={backHref} backLabel={backLabel} />}
    <main id="main-content"><slot /></main>
  </body>
</html>
