<dialog class="gallery-viewer" aria-labelledby="viewer-title">
  <button class="viewer-close" type="button" aria-label="Close project">×</button>
  <div data-viewer-content></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.gallery-viewer');
  const content = dialog?.querySelector<HTMLElement>('[data-viewer-content]');
  const close = dialog?.querySelector<HTMLButtonElement>('.viewer-close');
  if (dialog && content && close) {
    let activeProject: HTMLDetailsElement | null = null;
    let slide = 0;
    let figures: HTMLElement[] = [];
    let dots: HTMLButtonElement[] = [];
    let status: HTMLElement | null = null;
    let touchStart: { x: number; y: number } | null = null;

    function fitVisualProject() {
      if (!dialog!.open || !dialog!.classList.contains('gallery-viewer--visual')) return;
      const header = content!.querySelector<HTMLElement>('.project-header')!;
      const media = content!.querySelector<HTMLElement>('[data-project-media]')!;
      // Use the first image's proportions for the whole project, including other slides.
      const first = figures[0].querySelector<HTMLImageElement | HTMLVideoElement>('img, video')!;
      const ratio = Number(first.getAttribute('width')) / Number(first.getAttribute('height')) || 1;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const mobile = window.matchMedia('(max-width: 900px)').matches;
      const gutter = (mobile ? 1.5 : 4) * rem;
      const maxWidth = Math.min(78 * rem, window.innerWidth - gutter);
      const maxHeight = Math.min(46 * rem, window.innerHeight - gutter);
      const style = getComputedStyle(media);
      const paddingX = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
      const paddingY = parseFloat(style.paddingTop) + parseFloat(style.paddingBottom);
      const controlsHeight = media.querySelector('.viewer-controls')?.getBoundingClientRect().height ?? 0;
      dialog!.style.width = `${maxWidth}px`;
      // Remeasure wrapped titles after narrowing the modal.
      for (let pass = 0; pass < 3; pass++) {
        const availableHeight = Math.max(0, maxHeight - header.getBoundingClientRect().height - paddingY - controlsHeight);
        const width = Math.min(maxWidth, Math.max(Math.min(22 * rem, maxWidth), availableHeight * ratio + paddingX));
        dialog!.style.width = `${width}px`;
        const imageHeight = Math.min((width - paddingX) / ratio, availableHeight);
        media.style.height = `${imageHeight + paddingY + controlsHeight}px`;
      }
    }
    window.addEventListener('resize', fitVisualProject);
    void document.fonts.ready.then(fitVisualProject);

    function showSlide(index: number) {
      slide = (index + figures.length) % figures.length;
      figures.forEach((figure, i) => {
        figure.hidden = i !== slide;
        const video = figure.querySelector<HTMLVideoElement>('video');
        if (video) {
          if (i === slide) {
            if (!video.hasAttribute('src')) { video.src = video.dataset.fullSrc!; video.load(); }
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) void video.play().catch(() => { video.controls = true; });
          } else video.pause();
        }
        const image = figure.querySelector<HTMLImageElement>('img');
        if (i === slide && image?.dataset.fullSrc && !image.hasAttribute('src')) image.src = image.dataset.fullSrc;
      });
      dots.forEach((dot, i) => { dot.setAttribute('aria-pressed', String(i === slide)); });
      if (status) status.textContent = `${slide + 1} / ${figures.length}`;
    }

    function openProject(project: HTMLDetailsElement) {
      const detail = project.querySelector<HTMLElement>('[data-project-detail]');
      if (!detail) return;
      activeProject = project;
      const clone = detail.cloneNode(true) as HTMLElement;
      clone.querySelector('[data-project-title]')!.id = 'viewer-title';
      const media = clone.querySelector<HTMLElement>('[data-project-media]')!;
      figures = Array.from(media.querySelectorAll('figure'));
      dots = [];
      status = null;
      // Load only the selected image/video; hidden animations do not download or play.
      figures.forEach((figure) => {
        const video = figure.querySelector<HTMLVideoElement>('video');
        if (video) {
          video.dataset.fullSrc = video.getAttribute('src')!;
          video.removeAttribute('src');
          video.muted = true;
          const state = document.createElement('p');
          state.className = 'viewer-image-status';
          state.setAttribute('role', 'status');
          state.textContent = 'Loading animation…';
          figure.append(state);
          video.addEventListener('playing', () => { state.hidden = true; });
          video.addEventListener('loadeddata', () => { state.hidden = true; });
          video.addEventListener('waiting', () => { state.hidden = false; state.textContent = 'Loading animation…'; });
          video.addEventListener('error', () => { state.hidden = false; state.textContent = 'Animation could not be loaded.'; });
          return;
        }
        const img = figure.querySelector<HTMLImageElement>('img')!;
        img.dataset.fullSrc = img.getAttribute('src')!;
        img.removeAttribute('src');
        img.loading = 'eager';
        img.hidden = true;
        const state = document.createElement('p');
        state.className = 'viewer-image-status';
        state.setAttribute('role', 'status');
        state.textContent = 'Loading image…';
        figure.append(state);
        img.addEventListener('load', () => { state.hidden = true; img.hidden = false; });
        img.addEventListener('error', () => { state.textContent = 'Image could not be loaded.'; });
      });
      if (figures.length > 1) {
        const controls = document.createElement('div');
        controls.className = 'viewer-controls';
        const previous = document.createElement('button');
        previous.type = 'button'; previous.textContent = '←'; previous.setAttribute('aria-label', 'Previous photo');
        previous.addEventListener('click', () => showSlide(slide - 1));
        const next = document.createElement('button');
        next.type = 'button'; next.textContent = '→'; next.setAttribute('aria-label', 'Next photo');
        next.addEventListener('click', () => showSlide(slide + 1));
        const dotGroup = document.createElement('div');
        dotGroup.className = 'viewer-dots';
        dots = figures.map((_, i) => {
          const dot = document.createElement('button');
          dot.type = 'button'; dot.setAttribute('aria-label', `Photo ${i + 1}`);
          dot.addEventListener('click', () => showSlide(i)); dotGroup.append(dot); return dot;
        });
        status = document.createElement('span'); status.className = 'viewer-count'; status.setAttribute('aria-live', 'polite');
        controls.append(previous, dotGroup, status, next);
        media.append(controls);
      }
      showSlide(0);
      content!.replaceChildren(clone);
      dialog!.classList.toggle('gallery-viewer--visual', clone.classList.contains('project-detail--visual'));
      dialog!.style.removeProperty('width');
      if (!dialog!.open) dialog!.showModal();
      fitVisualProject();
      content!.scrollTop = 0;
      document.body.classList.add('viewer-open');
      close!.focus();
    }

    const projects = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-project]'));
    for (const project of projects) {
      project.querySelector('[data-project-open]')?.addEventListener('click', (event) => {
        event.preventDefault();
        openProject(project);
      });
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) content.querySelectorAll('video').forEach(video => video.pause());
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      content.querySelectorAll('video').forEach(video => { video.pause(); video.removeAttribute('src'); video.load(); });
      content.replaceChildren();
      document.body.classList.remove('viewer-open');
      activeProject?.querySelector<HTMLElement>('summary')?.focus();
    });
    dialog.addEventListener('keydown', (event) => {
      if ((event.target as HTMLElement).closest('video')) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault(); showSlide(slide + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    content.addEventListener('touchstart', (event) => {
      const target = event.target as HTMLElement;
      touchStart = target.closest('[data-project-media]') && !target.closest('button, video') ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null;
    }, { passive: true });
    content.addEventListener('touchend', (event) => {
      if (!touchStart) return;
      const dx = event.changedTouches[0].clientX - touchStart.x;
      const dy = event.changedTouches[0].clientY - touchStart.y;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) showSlide(slide + (dx < 0 ? 1 : -1));
      touchStart = null;
    }, { passive: true });
  }
</script>
